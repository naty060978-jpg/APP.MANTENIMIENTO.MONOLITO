import json
import os
from datetime import datetime
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas
from reportlab.lib.utils import ImageReader
from google.colab import files
from PIL import Image

# 1. EL MOLDE DEL EQUIPO: Define la estructura de un equipo de aire acondicionado.
class AireAcondicionado:
    def __init__(self, sector, marca, modelo, n_serie, tipo, frigorias, refrigerante, cantidad_gas, consumo, fecha):
        self.sector = sector
        self.marca = marca
        self.modelo = modelo
        self.n_serie = n_serie
        self.tipo = tipo
        self.frigorias = frigorias
        self.refrigerante = refrigerante
        self.cantidad_gas = cantidad_gas
        self.consumo = consumo
        self.fecha = fecha
        self.filtros = ""
        self.presion = ""
        self.condensadora = ""
        self.drenaje = ""
        self.observaciones = ""
        self.ruta_foto = None # Ruta al archivo de la foto adjunta

# 2. LÓGICA DEL SISTEMA: Gestiona el flujo de mantenimiento y la interacción con el usuario.
class SistemaGestionMantenimiento:
    def __init__(self):
        self.lista_equipos = []
        self.archivo_datos = "clientes_mantenimiento.json" # Nombre del archivo para guardar los datos
        self.base_datos = self.cargar_datos() # Carga los datos de clientes existentes
        self.empresa_mantenedora = "" # Nombre de la empresa que realiza el mantenimiento
        self.pre_uploaded_images = {} # Almacena las imágenes pre-cargadas al inicio

    def cargar_datos(self):
        # Carga la base de datos de clientes desde un archivo JSON.
        if os.path.exists(self.archivo_datos):
            try:
                with open(self.archivo_datos, "r") as f:
                    return json.load(f)
            except:
                return {} # Retorna un diccionario vacío si hay un error al cargar
        return {} # Retorna un diccionario vacío si el archivo no existe

    def guardar_datos(self, cliente, sitio, direccion):
        # Guarda los datos de los equipos en la base de datos.
        equipos_para_guardar = []
        for eq in self.lista_equipos:
            d = vars(eq).copy()
            d['ruta_foto'] = None # No guardamos la ruta de la foto en el JSON, solo en memoria para el PDF actual
            equipos_para_guardar.append(d)

        # Lógica para almacenar datos por cliente y luego por dirección.
        # Esto permite que un mismo cliente tenga múltiples direcciones con diferentes equipos.
        if cliente not in self.base_datos:
            self.base_datos[cliente] = {"direcciones": {}}
        self.base_datos[cliente]["direcciones"][direccion] = {"sitio": sitio, "equipos": equipos_para_guardar}

        with open(self.archivo_datos, "w") as f:
            json.dump(self.base_datos, f, indent=4)

    def seleccionar_tipo(self):
        # Permite al usuario seleccionar el tipo de equipo de una lista predefinida.
        opciones = ["Split Pared", "Baja Silueta", "Cassette", "Piso-Techo", "Rooftop", "MultiSplit", "Otro"]
        print("\n--- SELECCIONE TIPO DE EQUIPO ---")
        for i, opt in enumerate(opciones, 1): print(f"{i}. {opt}")
        while True:
            eleccion = input("Seleccione el número de tipo (1-7): ")
            if eleccion.isdigit() and 1 <= int(eleccion) <= len(opciones): return opciones[int(eleccion)-1]
            print("❌ Error: Elija un número válido.")

    def generar_pdf(self, cliente, sitio, direccion, tecnico_nombre):
        # Genera un reporte PDF con la información del mantenimiento de los equipos.
        nombre_pdf = f"Reporte_{cliente}_{sitio}.pdf".replace(" ", "_")
        c = canvas.Canvas(nombre_pdf, pagesize=letter)
        y = 750

        c.setFont("Helvetica-Bold", 16)
        c.drawString(50, y, self.empresa_mantenedora.upper())
        c.setFont("Helvetica", 10)
        c.drawString(450, y, f"Fecha: {datetime.now().strftime('%d/%m/%Y')}")
        y -= 25
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, "REPORTE TÉCNICO DE MANTENIMIENTO")
        y -= 20
        c.setFont("Helvetica", 11)
        c.drawString(50, y, f"CLIENTE: {cliente} | SITIO: {sitio}")
        y -= 15
        c.drawString(50, y, f"DIRECCIÓN: {direccion}")
        y -= 15
        c.drawString(50, y, f"TÉCNICO: {tecnico_nombre}") # Muestra el nombre del técnico
        c.line(50, y-10, 550, y-10)
        y -= 40

        for eq in self.lista_equipos:
            if y < 200: # Si queda poco espacio en la página, crea una nueva página
                c.showPage()
                y = 750

            c.setFont("Helvetica-Bold", 11)
            c.drawString(50, y, f"SECTOR: {eq.sector} | TIPO: {eq.tipo}")
            y -= 15
            c.setFont("Helvetica", 10)
            c.drawString(60, y, f"Marca/Modelo: {eq.marca} {eq.modelo} | S/N: {eq.n_serie}")
            y -= 15
            c.drawString(60, y, f"Técnico: {eq.frigorias} fg | Gas: {eq.refrigerante} | Consumo: {eq.consumo}")
            y -= 15
            c.setFont("Helvetica-Oblique", 10)
            c.drawString(60, y, f"ESTADO: Filtros: {eq.filtros} | Presión: {eq.presion} PSI | Drenaje: {eq.drenaje}")
            y -= 15
            c.drawString(60, y, f"OBSERVACIONES: {eq.observaciones}")
            y -= 10

            if eq.ruta_foto and os.path.exists(eq.ruta_foto):
                try:
                    img = ImageReader(eq.ruta_foto)
                    c.drawImage(img, 60, y - 150, width=200, height=150, preserveAspectRatio=True)
                    y -= 160
                except:
                    y -= 10 # Si falla la carga de imagen, solo ajusta el espaciado

            y -= 10
            c.line(50, y, 300, y)
            y -= 30

        c.save()
        return nombre_pdf

    def completar_mantenimiento(self, eq):
        # Guía al usuario a través del checklist de mantenimiento para un equipo específico.
        print(f"\n--- Checklist Mantenimiento: {eq.sector} ---")
        eq.filtros = "OK" if input("- ¿Filtros limpios? (s/n): ").lower() == "s" else "SUCIOS"
        eq.presion = input("- Presión de refrigerante (PSI): ")
        eq.condensadora = "OK" if input("- ¿Condensadora limpia? (s/n): ").lower() == "s" else "SUCIA"
        eq.drenaje = "OK" if input("- ¿Drenaje despejado? (s/n): ").lower() == "s" else "OBSTRUIDO"
        eq.observaciones = input("- Observaciones generales: ")

        # --- Lógica de Selección de Imagen ---
        print("\n--- ADJUNTO DE IMAGEN ---")
        if self.pre_uploaded_images:
            available_images = list(self.pre_uploaded_images.keys())
            if not available_images:
                print("No hay imágenes pre-subidas disponibles para seleccionar en este momento.")
                print("Para adjuntar imágenes, por favor, súbalas al inicio del programa.")
            else:
                print("Imágenes pre-subidas disponibles:")
                for i, filename in enumerate(available_images):
                    print(f"    {i+1}. {filename}")
                choice = input(f"Ingrese el NÚMERO o NOMBRE exacto de la imagen a adjuntar para '{eq.sector}' (o deje en blanco para no adjuntar): ").strip()
                if choice:
                    chosen_filename = None
                    if choice.isdigit() and 1 <= int(choice) <= len(available_images):
                        chosen_filename = available_images[int(choice)-1]
                    elif choice in available_images:
                        chosen_filename = choice

                    if chosen_filename:
                        eq.ruta_foto = chosen_filename
                        print(f"✅ Imagen '{chosen_filename}' adjuntada exitosamente a '{eq.sector}'.")
                    else:
                        print(f"❌ Error: El archivo '{choice}' no fue encontrado entre las imágenes pre-subidas. No se adjuntará imagen para '{eq.sector}'.")
                else:
                    print(f"No se adjuntará ninguna imagen para '{eq.sector}'.")
        else:
            print("⚠️ No se han pre-subido imágenes al inicio del programa. Por lo tanto, no es posible adjuntar fotos a los equipos en este momento.")
            print("Si necesita adjuntar imágenes, por favor, reinicie el programa y súbalas cuando se le solicite al principio.")
        # --- Fin de la Lógica de Selección de Imagen ---

    def iniciar_programa(self):
        # Inicia el flujo principal del programa, solicitando información del cliente y equipos.
        print("=== SISTEMA DE GESTIÓN DE MANTENIMIENTO ===")
        self.empresa_mantenedora = input("Nombre de la Empresa Mantenedora: ").strip() or "Empresa" # Solicita el nombre de la empresa
        cliente = input("Nombre del Cliente: ").strip()
        sitio = input("Sitio/Edificio: ")
        direccion = input("Dirección: ")
        tecnico_nombre = input("Nombre del Técnico: ").strip() # Solicita el nombre del técnico

        # --- Sección de Pre-Carga de Imágenes ---
        # Permite al usuario cargar todas las imágenes al inicio para evitar problemas interactivos.
        if input("¿Desea subir TODAS las imágenes de los equipos ahora? (s/n): ").lower() == 's':
            print("Por favor, seleccione TODAS las imágenes de los equipos que desea adjuntar.")
            print("Puedes seleccionar múltiples archivos a la vez en el diálogo de selección.")
            try:
                self.pre_uploaded_images = files.upload() # Carga las imágenes al diccionario
                if self.pre_uploaded_images:
                    print(f"✅ Archivos subidos: {', '.join(self.pre_uploaded_images.keys())}")
                else:
                    print("No se seleccionaron imágenes para pre-subir.")
            except Exception as e:
                print(f"❌ Error al pre-subir imágenes: {e}. Se procederá sin imágenes pre-subidas.")
        # --- Fin de la Sección de Pre-Carga de Imágenes ---

        if cliente in self.base_datos:
            # Verifica si los datos del cliente tienen la nueva estructura de 'direcciones'
            # y si la dirección específica ya existe.
            if "direcciones" in self.base_datos[cliente] and direccion in self.base_datos[cliente]["direcciones"]:
                print(f"✅ Cliente '{cliente}' con dirección '{direccion}' encontrado.")
                if input("¿Usar equipos guardados para esta dirección? (s/n): ").lower() == "s":
                    for data in self.base_datos[cliente]["direcciones"][direccion]['equipos']:
                        eq = AireAcondicionado(data['sector'], data['marca'], data['modelo'], data['n_serie'], data['tipo'], data['frigorias'], data['refrigerante'], data.get('cantidad_gas','N/A'), data.get('consumo','N/A'), datetime.now().strftime('%d/%m/%Y'))
                        self.completar_mantenimiento(eq)
                        self.lista_equipos.append(eq)
                    self.finalizar(cliente, sitio, direccion, tecnico_nombre)
                    return
            else:
                print(f"Cliente '{cliente}' encontrado, pero la dirección '{direccion}' no tiene equipos guardados. Procediendo a añadir nuevos equipos.")

        while True:
            tipo_eq = self.seleccionar_tipo()
            eq = AireAcondicionado(input("Sector: "), input("Marca: "), input("Modelo: "), input("S/N: "), tipo_eq, input("Frigorías: "), input("Gas: "), input("Gramos: "), input("Consumo: "), datetime.now().strftime('%d/%m/%Y'))
            self.completar_mantenimiento(eq)
            self.lista_equipos.append(eq)
            if input("\n¿Añadir otro equipo? (s/n): ").lower() != 's': break

        self.finalizar(cliente, sitio, direccion, tecnico_nombre) # Llama a finalizar, pasando el nombre del técnico

    def finalizar(self, cliente, sitio, direccion, tecnico_nombre):
        # Guarda los datos y genera el PDF al finalizar el proceso.
        self.guardar_datos(cliente, sitio, direccion)
        pdf = self.generar_pdf(cliente, sitio, direccion, tecnico_nombre) # Genera el PDF, pasando el nombre del técnico
        files.download(pdf) # Descarga el PDF generado

app = SistemaGestionMantenimiento()
app.iniciar_programa()
